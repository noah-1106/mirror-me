# ── LLM（文本：回应 / 镜子对话）──
# 任意 OpenAI 兼容接口都可。默认 Kimi（Moonshot），也兼容 DeepSeek。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# DeepSeek 备选（填了会优先于 KIMI_*）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# ── 一站式语音模型（可选，替换浏览器 ASR/TTS 降级链）──
# 阿里 Qwen-Omni：文字+音频进、语音出，OpenAI 兼容
# OMNI_API_KEY=          # DashScope API Key
# OMNI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OMNI_MODEL=qwen-omni-turbo
# OMNI_VOICE=Cherry      # 内置音色：Cherry / Ethan / Serena 等

# ── 豆包（火山引擎）TTS ──
# 火山引擎控制台 → 语音技术 → 应用管理，创建应用后获得
# VOICE_APPID=
# VOICE_ACCESS_TOKEN=
# VOICE_CLUSTER=volcano_tts
# 人设声线（Doubao-声音复刻：每人录 ~10 秒得专属 voice id；未复刻前填内置音色）
# VOICE_TYPE_A=zh_male_yunzhou      # 演示者 A（男）
# VOICE_TYPE_B=zh_female_qingxin    # 演示者 B（女）

# ── 本地 Kokoro TTS sidecar（无云依赖）──
# 启动：cd sidecar && HF_ENDPOINT=https://hf-mirror.com ./venv/bin/uvicorn tts_server:app --port 5100
# TTS_SIDECAR_URL=http://localhost:5100

PORT=3001
